# Set real values in Vercel environment settings; never commit secrets.
NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ADMIN_BOOTSTRAP_EMAIL=verified-owner@example.com
IMPORT_TOKEN=replace-with-a-long-random-secret
PUBLIC_INDEXING=0
# GOOGLE_SITE_VERIFICATION is the Google Search Console meta verification value.
# Vercel requires DATABASE_URL; Netlify's automatic database injection is unavailable.
# Local tests only (never set in production): NETLIFY_LOCAL_DB=1

# Questionnaire answers are stored in the database; optionally forward to Netlify Forms.
# Keep disabled on Vercel until an external notification endpoint is configured.
SURVEY_NOTIFICATIONS_ENABLED=0
