# Set real values in Netlify environment settings; never commit secrets.
NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.netlify.app
ADMIN_BOOTSTRAP_EMAIL=verified-owner@example.com
IMPORT_TOKEN=replace-with-a-long-random-secret
PUBLIC_INDEXING=0
# GOOGLE_SITE_VERIFICATION is the Google Search Console meta verification value.
# Netlify Database credentials are injected by the platform.
# Local tests only (never set in Netlify): NETLIFY_LOCAL_DB=1

# Questionnaire answers are stored in the database; optionally forward to Netlify Forms.
# Set to 1 in Netlify's production environment after enabling form detection.
SURVEY_NOTIFICATIONS_ENABLED=0
